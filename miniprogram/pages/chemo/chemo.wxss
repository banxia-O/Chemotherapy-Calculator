/* pages/chemo/chemo.wxss */

/* 调色板：浅紫 #B7A3D9 / 浅青 #8FC5C0 / 米白 #FAF7F1
   质感要点：低饱和渐变 + 带色温的分层阴影 + 细描边 */

.container {
  min-height: 100vh;
  background: linear-gradient(165deg, #F1ECF8 0%, #FAF6F0 48%, #EBF4F2 100%);
  padding: 32rpx 28rpx 72rpx;
}

/* 标题 */
.header {
  text-align: center;
  margin: 12rpx 0 36rpx;
}

.title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #5E5080;
  text-shadow: 0 2rpx 4rpx rgba(150,130,185,0.18);
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 26rpx;
  box-shadow:
    0 12rpx 30rpx rgba(140,120,180,0.10),
    0 2rpx 6rpx rgba(120,140,150,0.05);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  font-size: 31rpx;
  font-weight: 600;
  color: #4A4458;
  letter-spacing: 0.5rpx;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(160deg, #C2AEE2, #A28FCB);
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.title-bar.green {
  background: linear-gradient(160deg, #9ED0CB, #7DB6B0);
}

/* 输入行 */
.input-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.input-item {
  flex: 1;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8C879A;
  margin-bottom: 14rpx;
  letter-spacing: 0.5rpx;
}

.input-item input {
  width: 100%;
  height: 84rpx;
  padding: 20rpx 26rpx;
  border: 2rpx solid #ECE7F3;
  border-radius: 18rpx;
  font-size: 32rpx;
  color: #3A3548;
  background: #FBFAFD;
  box-sizing: border-box;
  transition: all 0.25s ease;
}

.input-item input:focus {
  border-color: #B7A3D9;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(183,163,217,0.15);
}

/* BSA显示 */
.bsa-display {
  background: linear-gradient(135deg, #BCA9DE 0%, #9B86C7 100%);
  border-radius: 22rpx;
  padding: 36rpx;
  text-align: center;
  color: #fff;
  margin-top: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(155,134,199,0.30);
}

.bsa-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.92;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.bsa-value {
  font-size: 66rpx;
  font-weight: 700;
  display: block;
  line-height: 1.1;
}

.bsa-unit {
  font-size: 28rpx;
  opacity: 0.9;
}

/* Picker选择器 */
.picker-item {
  margin-bottom: 24rpx;
}

.picker-value {
  padding: 22rpx 26rpx;
  min-height: 84rpx;
  line-height: 40rpx;
  border: 2rpx solid #ECE7F3;
  border-radius: 18rpx;
  font-size: 30rpx;
  color: #3A3548;
  background: #FBFAFD;
  box-sizing: border-box;
}

.picker-value.placeholder {
  color: #ABA6B8;
}

.picker-value.small {
  padding: 0 26rpx;
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #AC97D4 0%, #9580C2 100%);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(149,128,194,0.32);
}

.btn-primary::after {
  border: none;
}

.btn-green {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #93C9C3 0%, #74AFA9 100%);
  color: #fff;
  border: none;
  border-radius: 20rpx;
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(116,175,169,0.30);
}

.btn-green::after {
  border: none;
}

/* 卡铂结果 */
.carbo-result {
  background: linear-gradient(135deg, #93C9C3 0%, #74AFA9 100%);
  border-radius: 22rpx;
  padding: 36rpx;
  text-align: center;
  color: #fff;
  margin-top: 26rpx;
  box-shadow: 0 10rpx 24rpx rgba(116,175,169,0.30);
}

.carbo-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.92;
  letter-spacing: 1rpx;
}

.carbo-value {
  font-size: 66rpx;
  font-weight: 700;
  display: block;
  margin: 10rpx 0;
  line-height: 1.1;
}

.carbo-unit {
  font-size: 28rpx;
  opacity: 0.9;
}

.carbo-gfr {
  display: block;
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 14rpx;
}

/* 公式说明 */
.formula-note {
  background: #EDF6F4;
  border-left: 6rpx solid #93C9C3;
  padding: 22rpx 26rpx;
  border-radius: 0 14rpx 14rpx 0;
  margin-top: 26rpx;
}

.note-title {
  display: block;
  font-weight: 600;
  color: #3E726C;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.note-text {
  display: block;
  font-size: 24rpx;
  color: #4E7E78;
  line-height: 1.65;
}

/* 结果卡片 */
.result-card {
  border: 2rpx solid #E2D6F2;
  box-shadow:
    0 14rpx 34rpx rgba(155,134,199,0.16),
    0 2rpx 6rpx rgba(120,140,150,0.05);
}

.result-header {
  margin-bottom: 26rpx;
}

.regimen-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.setting-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #BCA9DE, #9B86C7);
  padding: 5rpx 18rpx;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 10rpx rgba(155,134,199,0.28);
}

.regimen-name {
  font-size: 35rpx;
  font-weight: 700;
  color: #3A3548;
}

.regimen-cycle {
  font-size: 26rpx;
  color: #9A95A8;
}

/* 药物列表 */
.drug-list {
  margin-bottom: 26rpx;
}

.drug-item {
  background: #F7F4FC;
  border: 2rpx solid #F0EAF8;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
}

.drug-name {
  font-weight: 600;
  color: #3A3548;
  font-size: 30rpx;
  margin-bottom: 14rpx;
}

.drug-dose-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.standard-dose {
  font-size: 26rpx;
  color: #9A95A8;
}

.calculated-dose {
  font-size: 38rpx;
  font-weight: 700;
  color: #8B72B8;
}

.drug-schedule {
  font-size: 24rpx;
  color: #A8A3B5;
  line-height: 1.5;
}

.auc-tip {
  background: #EDF6F4;
  color: #3E726C;
  font-size: 24rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  margin-top: 14rpx;
}

/* 备注框 */
.notes-box {
  background: #FAF6EF;
  border-left: 6rpx solid #D8C6A6;
  padding: 22rpx 26rpx;
  border-radius: 0 14rpx 14rpx 0;
}

.notes-title {
  display: block;
  font-weight: 600;
  color: #8A7B5C;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.notes-content {
  font-size: 26rpx;
  color: #7C7058;
  line-height: 1.7;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 44rpx 20rpx 10rpx;
}

.footer text {
  display: block;
  color: #A59FB5;
  font-size: 24rpx;
  line-height: 1.85;
}
