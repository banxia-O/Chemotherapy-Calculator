/* pages/chemo/chemo.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 标题 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.title-bar.green {
  background: linear-gradient(135deg, #11998e, #38ef7d);
}

/* 输入行 */
.input-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.input-item {
  flex: 1;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-item input {
  width: 100%;
  padding: 24rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.input-item input:focus {
  border-color: #667eea;
}

/* BSA显示 */
.bsa-display {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  color: #fff;
  margin-top: 16rpx;
}

.bsa-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.bsa-value {
  font-size: 64rpx;
  font-weight: bold;
  display: block;
}

.bsa-unit {
  font-size: 28rpx;
  opacity: 0.9;
}

/* Picker选择器 */
.picker-item {
  margin-bottom: 24rpx;
}

.picker-value {
  padding: 24rpx;
  border: 3rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
  background: #fff;
}

.picker-value.placeholder {
  color: #999;
}

.picker-value.small {
  padding: 24rpx;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.btn-primary::after {
  border: none;
}

.btn-green {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.btn-green::after {
  border: none;
}

/* 卡铂结果 */
.carbo-result {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  color: #fff;
  margin-top: 24rpx;
}

.carbo-label {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
}

.carbo-value {
  font-size: 64rpx;
  font-weight: bold;
  display: block;
  margin: 8rpx 0;
}

.carbo-unit {
  font-size: 28rpx;
  opacity: 0.9;
}

.carbo-gfr {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}

/* 公式说明 */
.formula-note {
  background: #e3f2fd;
  border-left: 6rpx solid #2196f3;
  padding: 20rpx 24rpx;
  border-radius: 0 12rpx 12rpx 0;
  margin-top: 24rpx;
}

.note-title {
  display: block;
  font-weight: 600;
  color: #1565c0;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.note-text {
  display: block;
  font-size: 24rpx;
  color: #1565c0;
  line-height: 1.6;
}

/* 结果卡片 */
.result-card {
  border: 3rpx solid #667eea;
}

.result-header {
  margin-bottom: 24rpx;
}

.regimen-name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.regimen-cycle {
  font-size: 26rpx;
  color: #888;
}

/* 药物列表 */
.drug-list {
  margin-bottom: 24rpx;
}

.drug-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.drug-name {
  font-weight: 600;
  color: #333;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}

.drug-dose-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.standard-dose {
  font-size: 26rpx;
  color: #888;
}

.calculated-dose {
  font-size: 34rpx;
  font-weight: bold;
  color: #667eea;
}

.drug-schedule {
  font-size: 24rpx;
  color: #999;
}

.auc-tip {
  background: #fff3cd;
  color: #856404;
  font-size: 24rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

/* 备注框 */
.notes-box {
  background: #fff3cd;
  border-left: 6rpx solid #ffc107;
  padding: 20rpx 24rpx;
  border-radius: 0 12rpx 12rpx 0;
}

.notes-title {
  display: block;
  font-weight: 600;
  color: #856404;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.notes-content {
  font-size: 26rpx;
  color: #856404;
  line-height: 1.6;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 20rpx;
}

.footer text {
  display: block;
  color: rgba(255,255,255,0.7);
  font-size: 24rpx;
  line-height: 1.8;
}